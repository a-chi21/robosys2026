"""omikuji: 標準入力の願い事から運勢を引く決定論的おみくじコマンド。"""

import argparse
import hashlib
import os
import sys

FORTUNES = [
    {
        "rank": "大吉",
        "lead": "願いは、声に出した瞬間から動く。",
        "wish": "思いがけない形で叶う",
        "wait": "待つより、こちらから",
        "trip": "遠くへ。道中つつがなし",
    },
    {
        "rank": "中吉",
        "lead": "急がずとも、流れはもう来ている。",
        "wish": "半歩手前まで来ている",
        "wait": "近いうちに便りあり",
        "trip": "近場なら、なお吉",
    },
    {
        "rank": "小吉",
        "lead": "小さな決断が、のちに効いてくる。",
        "wish": "ひとつに絞ると吉",
        "wait": "気を許せる相手と",
        "trip": "日帰りがちょうどいい",
    },
    {
        "rank": "吉",
        "lead": "平らかな日。整えることに運がある。",
        "wish": "続けていることが力になる",
        "wait": "礼を尽くせば実りあり",
        "trip": "支度を丁寧に",
    },
    {
        "rank": "末吉",
        "lead": "今は種をまく時。実りは少し先。",
        "wish": "焦らず育てば実る",
        "wait": "時間が味方になる",
        "trip": "延期もまた吉",
    },
    {
        "rank": "凶",
        "lead": "止まることも、運のうち。焦らない。",
        "wish": "いったん手を放すと見える",
        "wait": "無理に近づかず",
        "trip": "遠出は控えめに",
    },
]


def pick(text: str) -> dict:
    normalized = text.strip()
    digest = hashlib.sha256(normalized.encode("utf-8")).digest()
    index = int.from_bytes(digest[:8], "big") % len(FORTUNES)
    return FORTUNES[index]


def format_text(f: dict) -> str:
    return (
        f"{f['rank']} ─ {f['lead']}\n"
        f"願望: {f['wish']}\n"
        f"待人: {f['wait']}\n"
        f"旅  : {f['trip']}"
    )


def format_html(f: dict) -> str:
    """テンプレートHTMLを読み込み、結果を埋め込んで返す。"""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    template_path = os.path.join(script_dir, "index.html")
    with open(template_path, encoding="utf-8") as fp:
        html = fp.read()

    rank = f["rank"]
    replacements = {
        "{{RANK}}": rank,
        "{{RANK1}}": rank[0] if len(rank) > 0 else "",
        "{{RANK2}}": rank[1] if len(rank) > 1 else "",
        "{{LEAD}}": f["lead"],
        "{{WISH}}": f["wish"],
        "{{WAIT}}": f["wait"],
        "{{TRIP}}": f["trip"],
    }
    for key, value in replacements.items():
        html = html.replace(key, value)
    return html


def main() -> int:
    parser = argparse.ArgumentParser(description="おみくじを引く")
    parser.add_argument("--html", action="store_true",
                        help="結果を埋め込んだHTMLを標準出力に出す")
    args = parser.parse_args()

    text = sys.stdin.read()
    if not text.strip():
        print("omikuji: 標準入力が空です。願い事を入力してください。",
              file=sys.stderr)
        return 1

    fortune = pick(text)
    if args.html:
        print(format_html(fortune))
    else:
        print(format_text(fortune))
    return 0


if __name__ == "__main__":
    sys.exit(main())