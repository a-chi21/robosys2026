import sys
import random
import datetime

unsei = ["大吉", "中吉", "小吉", "吉", "末吉", "凶"]
itsu = ["朝のうちに", "お昼ごろ", "夕方に", "寝る前に"]
nani = ["散歩をすると", "人に親切にすると", "部屋を片づけると", "甘いものを食べると"]
kekka = ["幸運が訪れます", "良い知らせが届きます", "気分が晴れます", "新しい発見があります"]

today = datetime.date.today().isoformat()
for line in sys.stdin:
    name = line.rstrip()
    if name == "":
        continue
    random.seed(name + today)                  # 名前＋日付で結果を固定
    print(f"{name}さん：{random.choice(unsei)}")
    print("  " + random.choice(itsu) + random.choice(nani) + random.choice(kekka))
#   Escapeキーを２秒以上押し続けたらプログラム終了
    while  True:
        if keyboard.is_pressed('escape'):
            messagebox.showinfo('メッセージ','処理を終了しました。')
            sys.exit()
        time.sleep(2)
